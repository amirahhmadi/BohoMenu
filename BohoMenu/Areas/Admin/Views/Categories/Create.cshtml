@using Microsoft.AspNetCore.Mvc.TagHelpers
@model BohoMenu.Core.DTOs.Requests.Category.CreateCategoryRequest

@{
    ViewData["Title"] = "افزودن دسته‌بندی";
}

<div class="page-content">
    <div class="container-fluid">

        <div class="row mb-4">
            <div class="col-12">
                <div>
                    <h4 class="mb-1">افزودن دسته‌بندی</h4>
                    <p class="text-muted mb-0">
                        ایجاد دسته‌بندی جدید برای منوی رستوران
                    </p>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-xl-6 col-lg-8">

                <div class="card">
                    <div class="card-body">

                        <h5 class="card-title mb-4">
                            اطلاعات دسته‌بندی
                        </h5>

                        <form method="post" asp-action="Create">
                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>

                            <div class="mb-4">
                                <label asp-for="Title" class="form-label">
                                    نام دسته‌بندی
                                </label>

                                <input asp-for="Title"
                                       class="form-control"
                                       placeholder="مثلاً غذاهای اصلی"
                                       maxlength="100" />

                                <span asp-validation-for="Title"
                                      class="text-danger small">
                                </span>

                                <small class="text-muted d-block mt-2">
                                    نام دسته‌بندی را وارد کنید.
                                </small>
                            </div>

                            <div class="d-flex align-items-center gap-2">

                                <button type="submit" class="btn btn-primary">
                                    <i data-eva="plus-outline" class="me-1"></i>
                                    ثبت دسته‌بندی
                                </button>

                                <a asp-action="Index" class="btn btn-light">
                                    انصراف
                                </a>

                            </div>

                        </form>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
