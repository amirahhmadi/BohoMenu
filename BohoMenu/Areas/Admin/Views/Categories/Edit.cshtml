@using Microsoft.AspNetCore.Mvc.TagHelpers
@model BohoMenu.Core.DTOs.Requests.Category.UpdateCategoryRequest
@{
    ViewData["Title"] = "ویرایش دسته‌بندی";
}

<div class="page-content">
    <div class="container-fluid">

        <!-- Page Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div>
                    <h4 class="mb-1">ویرایش دسته‌بندی</h4>
                    <p class="text-muted mb-0">
                        تغییر نام دسته‌بندی موردنظر
                    </p>
                </div>
            </div>
        </div>

        <div class="row">

            <div class="col-xl-6 col-lg-8">

                <div class="card">
                    <div class="card-body">

                        <h5 class="card-title mb-4">
                            اطلاعات دسته‌بندی
                        </h5>

                        <form method="post"
                              asp-area="Admin"
                              asp-controller="Categories"
                              asp-action="Edit">

                            @Html.AntiForgeryToken()

                            <input type="hidden" asp-for="Id" />

                            <!-- Category Name -->
                            <div class="mb-4">

                                <label asp-for="Title" class="form-label">
                                    نام دسته‌بندی
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="Title"
                                       class="form-control"
                                       placeholder="مثلاً غذاهای اصلی"
                                       maxlength="100"
                                       required />

                                <span asp-validation-for="Title"
                                      class="text-danger"></span>

                            </div>

                            <hr />

                            <!-- Buttons -->
                            <div class="d-flex align-items-center gap-2">

                                <button type="submit"
                                        class="btn btn-primary">

                                    <i data-eva="save-outline" class="me-1"></i>
                                    ذخیره تغییرات

                                </button>

                                <a asp-area="Admin"
                                   asp-controller="Categories"
                                   asp-action="Index"
                                   class="btn btn-light">

                                    انصراف

                                </a>

                            </div>

                        </form>

                    </div>
                </div>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
