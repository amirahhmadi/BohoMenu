@model BohoMenu.Core.DTOs.Requests.Admin.AdminChangePasswordRequest

@{
    ViewData["Title"] = "تغییر رمز عبور";
}

<div class="page-content" dir="rtl">

    <div class="container-fluid">

        <!-- Page Header -->
        <div class="row mb-4">
            <div class="col-12">

                <div class="d-flex align-items-center justify-content-between">

                    <div>
                        <h4 class="mb-1">
                            تغییر رمز عبور
                        </h4>

                        <p class="text-muted mb-0">
                            از این قسمت می‌توانید رمز عبور حساب مدیریت را تغییر دهید.
                        </p>
                    </div>

                </div>

            </div>
        </div>

        <!-- Change Password Form -->
        <div class="row justify-content-center">

            <div class="col-xl-6 col-lg-7 col-md-9">

                <div class="card">

                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="mdi mdi-lock-outline me-1"></i>
                            اطلاعات رمز عبور
                        </h5>
                    </div>

                    <div class="card-body">

                        <form asp-area="Admin"
                              asp-controller="AdminAccount"
                              asp-action="ChangePassword"
                              method="post">

                            @Html.AntiForgeryToken()

                            <!-- Validation Summary -->
                            <div asp-validation-summary="ModelOnly"
                                 class="alert alert-danger"
                                 role="alert"></div>

                            <!-- Current Password -->
                            <div class="mb-4">

                                <label asp-for="CurrentPassword"
                                       class="form-label">
                                    رمز عبور فعلی
                                    <span class="text-danger">*</span>
                                </label>

                                <div class="input-group">

                                    <input asp-for="CurrentPassword"
                                           type="password"
                                           class="form-control password-input"
                                           placeholder="رمز عبور فعلی را وارد کنید"
                                           autocomplete="current-password" />

                                    <button type="button"
                                            class="btn btn-light toggle-password"
                                            aria-label="نمایش رمز عبور">
                                        <i class="mdi mdi-eye-outline"></i>
                                    </button>

                                </div>

                                <span asp-validation-for="CurrentPassword"
                                      class="text-danger small"></span>

                            </div>

                            <!-- New Password -->
                            <div class="mb-4">

                                <label asp-for="NewPassword"
                                       class="form-label">
                                    رمز عبور جدید
                                    <span class="text-danger">*</span>
                                </label>

                                <div class="input-group">

                                    <input asp-for="NewPassword"
                                           type="password"
                                           class="form-control password-input"
                                           placeholder="حداقل ۸ کاراکتر"
                                           autocomplete="new-password" />

                                    <button type="button"
                                            class="btn btn-light toggle-password"
                                            aria-label="نمایش رمز عبور">
                                        <i class="mdi mdi-eye-outline"></i>
                                    </button>

                                </div>

                                <span asp-validation-for="NewPassword"
                                      class="text-danger small"></span>

                            </div>

                            <!-- Confirm Password -->
                            <div class="mb-4">

                                <label asp-for="ConfirmPassword"
                                       class="form-label">
                                    تکرار رمز عبور جدید
                                    <span class="text-danger">*</span>
                                </label>

                                <div class="input-group">

                                    <input asp-for="ConfirmPassword"
                                           type="password"
                                           class="form-control password-input"
                                           placeholder="رمز عبور جدید را تکرار کنید"
                                           autocomplete="new-password" />

                                    <button type="button"
                                            class="btn btn-light toggle-password"
                                            aria-label="نمایش رمز عبور">
                                        <i class="mdi mdi-eye-outline"></i>
                                    </button>

                                </div>

                                <span asp-validation-for="ConfirmPassword"
                                      class="text-danger small"></span>

                            </div>

                            <!-- Password Hint -->
                            <div class="alert alert-info d-flex align-items-center"
                                 role="alert">

                                <i class="mdi mdi-information-outline fs-4 me-2"></i>

                                <div class="small">
                                    رمز عبور جدید باید حداقل ۸ کاراکتر داشته باشد.
                                    از ترکیب حروف و اعداد استفاده کنید.
                                </div>

                            </div>

                            <!-- Actions -->
                            <div class="d-flex justify-content-end gap-2 mt-4">

                                <a asp-area="Admin"
                                   asp-controller="Categories"
                                   asp-action="Index"
                                   class="btn btn-light">
                                    انصراف
                                </a>

                                <button type="submit"
                                        class="btn btn-primary">
                                    <i class="mdi mdi-lock-reset me-1"></i>
                                    تغییر رمز عبور
                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.querySelectorAll('.toggle-password').forEach(button => {

            button.addEventListener('click', function () {

                const input = this.parentElement.querySelector('.password-input');
                const icon = this.querySelector('i');

                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('mdi-eye-outline');
                    icon.classList.add('mdi-eye-off-outline');
                }
                else {
                    input.type = 'password';
                    icon.classList.remove('mdi-eye-off-outline');
                    icon.classList.add('mdi-eye-outline');
                }

            });

        });
    </script>

}
